# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in the values.
#  `.env` is git-ignored. Everything here is local.
# ─────────────────────────────────────────────────────────────

# ── Per-app identity (each copied folder is its own app) ──────
# Unique name that isolates THIS app's containers, network, and
# local database files from every other copy. `make init` generates
# a unique project name. Read automatically by Docker Compose.
COMPOSE_PROJECT_NAME=ai-php-app

# Host port for THIS app. Every running copy needs a different one;
# `make init` finds a free port automatically.
HTTP_PORT=8080

# App
APP_ENV=local                # "local" or "production"
APP_NAME="AI PHP App"

# ── Production hosting (auto-SSL) ─────────────────────────────
# Only used by the production overlay (make prod-up). The client
# points this domain's A record at the server; Caddy then issues and
# auto-renews the SSL certificate on its own. One host or several
# space-separated, e.g. "example.com www.example.com".
DOMAIN=example.com
LETSENCRYPT_EMAIL=you@example.com

# SSL / HTTPS:
#   on  = automatic HTTPS via Let's Encrypt (recommended, default)
#   off = serve plain HTTP only, no SSL — use when Cloudflare or another
#         proxy already handles HTTPS, or for internal apps without a domain.
SSL=on

# Postgres (local bind directory: application/data/postgres)
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# ── Email sending (app/Mail.php) ─────────────────────────────
# Use any SMTP provider (Postmark, SES, SendGrid, Gmail…). Leave
# MAIL_HOST blank to disable email. Port 587 = STARTTLS, 465 = SSL.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls          # tls | ssl | none
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME="AI PHP App"

# ── Deploy to the live server (make deploy) ──────────────────
# Only needed on your LOCAL machine. The online server you push to.
DEPLOY_HOST=                 # server IP or hostname (blank = deploy disabled)
DEPLOY_USER=root
DEPLOY_PATH=/opt/app-studio
DEPLOY_SSH_PORT=22

# ── Off-site backup copy (bin/backup.sh) ─────────────────────
# After each backup, also copy it somewhere OFF this server so data
# survives if the server dies. An rsync/scp target or local path.
# Leave blank to keep backups local only.
BACKUP_REMOTE=               # e.g. user@host:/backups/myapp  or  /mnt/drive/backups

# ── Uptime monitoring (make uptime) ──────────────────────────
# URL to check and where to alert if it's down.
UPTIME_URL=https://example.com/health
ALERT_EMAIL=                 # emailed via the MAIL_* settings above
ALERT_WEBHOOK=               # optional: POSTed to (Slack/Telegram/etc.)

# Local-only binding by default. Change deliberately for remote hosting.
HTTP_BIND=127.0.0.1
# Generated automatically by start.sh; used only by the isolated website role.
SITE_DB_PASSWORD=
# Local file ownership, filled automatically from the user running start.sh.
APP_UID=
APP_GID=

# Generated by startup; authenticates the private CLI service.
CLI_SERVICE_TOKEN=

# Separate schema-owner credential; never passed to generated website code.
MIGRATION_DB_PASSWORD=change-me
# Generated by startup; authenticates the offline security scanner.
AUDIT_SERVICE_TOKEN=change-me
