{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash application/bin/onboard-check.sh 2>/dev/null || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 application/bin/log-activity.py prompt 2>/dev/null || true",
            "statusMessage": "Logging request to work journal"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 application/bin/log-activity.py stop 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
